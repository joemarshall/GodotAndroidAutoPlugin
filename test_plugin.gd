extends MeshInstance3D

var tp
var camera

@export var texture:Texture2D
@export var image: Image


var camera_open = false
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	tp=	TestPlugin.new()
	tp.helloWorld()
	camera = AndroidCameraPlugin.new()
	camera.register_for_frames(_onFrame)
	camera.request_permission()

func _onFrame(w:int, h:int, data:PackedByteArray ):
	print("Got frame %dx%d (%d)! "%[w,h,len(data)])
	if not image or image.get_width()!=w or image.get_height()!=h:
		print("WOO")
		image = Image.create_from_data(w,h,false,Image.FORMAT_RGB8,data)
		texture=ImageTexture.create_from_image(image)
		var mat = get_active_material(0) as BaseMaterial3D
		mat.albedo_texture=texture		
	else:
		image.set_data(w,h,false,Image.FORMAT_RGB8,data)
		texture.update(image)
	

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	if camera_open==false and camera.has_permission():
		camera.start()
		camera_open=true
	else:
		if texture==null:
			var data: PackedByteArray
			data = [
				0xff,0x00,0xff,0xff,0x00,0xff,0xff,0x00,0xff,0xff,0x00,0xff,0xff,0x00,0xff,0xff,0x00,0xff,0xff,0x00,0xff,0xff,0x00,0xff,
				0xff,0x00,0xff,0xff,0x00,0xff,0xff,0x00,0xff,0xff,0x00,0xff,0xff,0x00,0xff,0xff,0x00,0xff,0xff,0x00,0xff,0xff,0x00,0xff,
